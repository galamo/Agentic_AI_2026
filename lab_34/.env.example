# OpenRouter (https://openrouter.ai) – used for the LLM calls
OPENROUTER_API_KEY=sk-or-...

# Neo4j connection (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Model used for answer synthesis and Cypher generation
LLM_MODEL=openai/gpt-4o-mini
